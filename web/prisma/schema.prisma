generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id        String     @id @default(cuid())
  ownerId   String
  name      String
  questions Question[]

  @@index([ownerId])
}

model Question {
  id              String   @id @default(cuid())
  courseId        String
  prompt          String
  referenceAnswer String
  rubric          String
  maxScore        Float
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@index([courseId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  score      Score?

  @@index([questionId])
}

model Score {
  id             String    @id @default(cuid())
  answerId       String    @unique
  suggestedScore Float
  confidence     Float
  needsReview    Boolean
  modelVersion   String
  finalScore     Float?
  reviewerNote   String?
  reviewedAt     DateTime?
  answer         Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)
}
